# Existing folder on the computer running Docker, not a folder on your browser PC.
# Linux/NAS: /volume1/movenex/csv
# Windows Docker Desktop: C:/MovenexECT/csv
ECT_CSV_DIR=/volume1/movenex/csv
ECT_OUTPUT_DIR=/volume1/movenex/output
ECT_CSV_FILE=C10A_49513-75270R.csv.gz
ECT_PRODUCT=C10A_49513-75270R
ECT_DATA_MODE=company

# Default: server-local access. Set the server's LAN IP for an internal network.
ECT_BIND_IP=127.0.0.1
ECT_PORT=8888

# Linux/NAS: set to the IDs of the account that can write ECT_OUTPUT_DIR (id -u / id -g).
ECT_UID=1000
ECT_GID=1000
